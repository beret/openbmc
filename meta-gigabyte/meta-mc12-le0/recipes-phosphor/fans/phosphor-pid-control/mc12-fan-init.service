[Unit]
Description=Initialize MC12-LE0 fan PWM outputs
Before=xyz.openbmc_project.fansensor.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 230/255 is about 90%; pwm2 is unconnected and pwm8 drives the speaker.
ExecStart=/bin/sh -ec 'for n in 1 3 4 5 6 7; do printf 230 > /sys/devices/platform/ahb/ahb:apb/1e786000.pwm-tacho-controller/hwmon/hwmon0/pwm$$n; done'

[Install]
WantedBy=xyz.openbmc_project.fansensor.service
