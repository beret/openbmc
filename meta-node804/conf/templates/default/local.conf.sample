MACHINE ??= "mc12-le0-node804"
DISTRO ?= "openbmc-phosphor"
PACKAGE_CLASSES ?= "package_ipk"
SANITY_TESTED_DISTROS:append ?= " *"
# allow-root-login is already set by EXTRA_IMAGE_FEATURES in
# conf/machine/mc12-le0.conf; leave this override commented unless replacing
# the machine default.
#EXTRA_IMAGE_FEATURES = "allow-root-login"
# MC12-LE0 board bring-up/test profile; not for production.
#DISTRO = "openbmc-phosphor-mc12-le0-bringup"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS = "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"

# Shared caches outside the per-machine build tree. Override CACHE_ROOT for the
# site; the other paths and the hash-equivalence database follow it.
CACHE_ROOT ?= "${TOPDIR}/../cache"
DL_DIR ?= "${CACHE_ROOT}/downloads"
SSTATE_DIR ?= "${CACHE_ROOT}/sstate"
BB_HASHSERVE_DB_DIR ?= "${SSTATE_DIR}"
# Remote sstate mirror and upstream hash server are disabled; the shared local
# SSTATE_DIR is authoritative. Enable only if deliberately consuming Yocto
# prebuilt artifacts.
#SSTATE_MIRRORS ?= "file://.* https://sstate.yoctoproject.org/dev/PATH;downloadfilename=PATH"

BB_HASHSERVE = "auto"
#BB_HASHSERVE_UPSTREAM = "wss://hashserv.yoctoproject.org/ws"
BB_SIGNATURE_HANDLER = "OEEquivHash"

# Limit concurrent BitBake tasks and make/ninja jobs to reduce cache thrashing
# on small hosts. These are defaults; adjust per build host.
BB_NUMBER_THREADS ?= "12"
PARALLEL_MAKE ?= "-j 12 -l 16"

# Compiler cache (shared across builds outside TMPDIR).
INHERIT += "ccache"
CCACHE_TOP_DIR ?= "${CACHE_ROOT}/ccache"
CCACHE_NATIVE_RECIPES_ALLOWED = "nodejs-native llvm-native"
